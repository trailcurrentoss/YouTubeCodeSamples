{
  "name": "fnirsi-psu-control",
  "version": "0.1.0",
  "description": "Cross-platform desktop control software for FNIRSI DC bench power supplies",
  "license": "MIT",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/**/*.test.js\"",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "serialport": "^12.0.0"
  },
  "build": {
    "appId": "org.opensource.fnirsi-psu-control",
    "productName": "FNIRSI PSU Control",
    "files": [
      "src/**/*",
      "!**/*.md"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools"
    }
  }
}
