# Crack the Safe co-processor (ESP32-U4WDH, 4 MB in-package flash).
CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
# Bluedroid with A2DP does not fit the default 1 MB app slot.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# Classic Bluetooth only: headphones are BR/EDR A2DP sinks; nothing here
# needs BLE, and dropping it frees controller memory.
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=n
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BTDM_CTRL_MODE_BTDM=n
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_A2DP_ENABLE=y
