        {
          "objID": "81d19e07-53df-712e-2e2b-4c0ae167adc0",
          "fileName": "vars.h",
          "template": "#ifndef EEZ_LVGL_UI_VARS_H\n#define EEZ_LVGL_UI_VARS_H\n\n#include <stdint.h>\n#include <stdbool.h>\n\n#ifdef __cplusplus\nextern \"C\" {\n#endif\n\n// enum declarations\n\n//${eez-studio FLOW_ENUMS}\n\n// Flow global variables\n\n//${eez-studio FLOW_GLOBAL_VARIABLES_ENUM}\n\n// Native global variables\n\n//${eez-studio LVGL_VARS_DECL}\n\n#ifdef __cplusplus\n}\n#endif\n\n#endif /*EEZ_LVGL_UI_VARS_H*/"
        },
        {
          "objID": "95c91924-a086-335d-9dc0-72d9b0d4f372",
          "fileName": "structs.h",
          "template": "#ifndef EEZ_LVGL_UI_STRUCTS_H\n#define EEZ_LVGL_UI_STRUCTS_H\n\n//${eez-studio EEZ_FOR_LVGL_CHECK}\n\n#if defined(EEZ_FOR_LVGL)\n\n#include <eez/flow/flow.h>\n#include <stdint.h>\n#include <stdbool.h>\n\n#include \"vars.h\"\n\nusing namespace eez;\n\n//${eez-studio FLOW_STRUCTS}\n\n//${eez-studio FLOW_STRUCT_VALUES}\n\n#endif\n\n#endif /*EEZ_LVGL_UI_STRUCTS_H*/\n"
        },
