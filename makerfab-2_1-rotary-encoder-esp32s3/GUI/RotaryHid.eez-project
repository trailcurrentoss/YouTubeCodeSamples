          "fileName": "fonts.h",
          "template": "#ifndef EEZ_LVGL_UI_FONTS_H\n#define EEZ_LVGL_UI_FONTS_H\n\n//${eez-studio LVGL_INCLUDE}\n\n#ifdef __cplusplus\nextern \"C\" {\n#endif\n\n//${eez-studio LVGL_FONTS_DECL}\n\n#ifdef __cplusplus\n}\n#endif\n\n#endif /*EEZ_LVGL_UI_FONTS_H*/"
