<?xml version="1.0" encoding="UTF-8"?>
<!--
  Openbox configuration for TrailShell.

  TrailShell is a shell, not a window manager: openbox does the focus, stacking
  and EWMH bookkeeping (_NET_CLIENT_LIST is what the task switcher reads), and
  this file reduces it to the phone-like policy the 640x480 panel needs.

  The three decisions that matter:

  1. Every normal window is undecorated and maximised. A title bar plus borders
     costs roughly 10% of a 640x480 screen to enable overlapping windows, which
     is something nobody wants on a 3.5" panel. Combined with the struts
     TrailShell sets, "maximised" resolves to exactly the 640x414 app canvas
     between the status bar and the nav bar.
  2. One desktop. Workspaces are a mouse-and-large-screen idea; the task
     switcher is the multitasking model here.
  3. No openbox keybindings at all. TrailShell grabs every shortcut itself from
     keymap.py so that the on-screen cheat sheet cannot drift out of date, and
     a duplicate binding here would shadow it silently.
-->
<openbox_config xmlns="http://openbox.org/3.4/rc">

  <resistance>
    <strength>0</strength>
    <screen_edge_strength>0</screen_edge_strength>
  </resistance>

  <focus>
    <focusNew>yes</focusNew>
    <!-- Touch is a click, not a hover: follow-mouse would focus whatever the
         pointer was last left over. -->
    <followMouse>no</followMouse>
    <focusLast>yes</focusLast>
    <underMouse>no</underMouse>
    <raiseOnFocus>yes</raiseOnFocus>
  </focus>

  <placement>
    <policy>Smart</policy>
    <center>yes</center>
  </placement>

  <theme>
    <name>Clearlooks</name>
    <!-- Empty title layout: nothing should draw a title bar, but if a client
         forces decoration anyway this keeps it to a bare strip. -->
    <titleLayout></titleLayout>
    <keepBorder>no</keepBorder>
    <animateIconify>no</animateIconify>
  </theme>

  <desktops>
    <number>1</number>
    <firstdesk>1</firstdesk>
    <names><name>Main</name></names>
    <popupTime>0</popupTime>
  </desktops>

  <resize>
    <drawContents>yes</drawContents>
    <popupShow>Never</popupShow>
  </resize>

  <margins><top>0</top><bottom>0</bottom><left>0</left><right>0</right></margins>

  <!-- TrailShell owns every shortcut. See trailshell/keymap.py. -->
  <keyboard>
    <chainQuitKey>C-g</chainQuitKey>
  </keyboard>

  <mouse>
    <dragThreshold>10</dragThreshold>
    <doubleClickTime>400</doubleClickTime>
    <screenEdgeWarpTime>0</screenEdgeWarpTime>

    <context name="Client">
      <mousebind button="Left" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
      </mousebind>
    </context>

    <!-- Deliberately empty: no root-window menus. A long-press or stray touch
         on the background must never summon a desktop menu, because there is
         no desktop metaphor here to explain it. -->
    <context name="Desktop"></context>
    <context name="Root"></context>
  </mouse>

  <applications>
    <!-- Normal windows: full-screen, chromeless. -->
    <application class="*" type="normal">
      <decor>no</decor>
      <maximized>yes</maximized>
      <focus>yes</focus>
      <desktop>1</desktop>
    </application>

    <!-- Dialogs stay their natural size but centred and undecorated; forcing
         a file chooser to full screen is fine, forcing a 200 px confirmation
         box to it is not. -->
    <application class="*" type="dialog">
      <decor>no</decor>
      <position force="yes"><x>center</x><y>center</y></position>
      <focus>yes</focus>
    </application>
  </applications>

</openbox_config>
